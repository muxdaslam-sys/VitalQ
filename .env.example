# ==============================================================================
# VitalQ - Local Docker Compose & Development Environment Blueprint
# ==============================================================================
# Copy this file to '.env' for local Docker Compose development:
#   cp .env.example .env
#
# NOTE: Never commit '.env' to version control.
# ==============================================================================

# Database Settings (Local SQL Server Express / Docker)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_DATABASE_NAME=VitalQ
MSSQL_SA_PASSWORD=YourStrongPasswordHere123!

# Backend API Settings
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5089
JWT_SECRET_KEY=YourSuperSecretKeyMustBeAtLeast32CharactersLong!
JWT_ISSUER=VitalQ
JWT_AUDIENCE=VitalQ
JWT_DURATION_MINUTES=60

# Frontend Web Client Settings
FRONTEND_PORT=4200
